  24          /*---------------------------------------------*
  25          数据帧，字节写data步骤
  26          s(开始)->s（发送字节）:address+w(写地址(从机地址))->RA(接收应答)->
  27          s（发送字节）:wordaddress（字节地址）->RA(接收应答)->
  28          s（发送字节）:data->stop（结束）
  29          -----------------------------------------------*/
  30          void AT24C02_Writebyte(unsigned char wordaddress,Data)    //输入写字节地址,字节数据先//写字节输入
  31          {
  32   1          I2C_Start();                  //开始用数据传输
  33   1          I2C_Sendbyte(AT24C02_ADDRESS);    //用数据发送（写）地址，存以后写的字节数据
  34   1          I2C_Receiveack();           //接收应答//按自己写的它是1的，但它测试变0了，说明电脑给了应答
  35   1          I2C_Sendbyte(wordaddress);
  36   1          I2C_Receiveack();           //接下来看看要在地址上写入什么数据
  37   1          I2C_Sendbyte(Data);
  38   1          I2C_Receiveack();   
  39   1          I2C_Stop();                 //结束后字节写好了  
  40   1          
  41   1      }
  42          ///*---------------------------------------------*
  43          //数据帧，字节读取data步骤
  44          //s(开始)->s（发送字节）:address+w(写地址)->RA(接收应答)->
  45          ////s（发送字节）:wordaddress（字节地址）->RA(接收应答)->
  46          //* ！*s(开始)//不结束原因保证数据帧只有1帧，多了会重复就乱了->
  47          //s（发送字节）:address+R(读地址(从机地址))->RA(接收应答)
  48          //->R(接收字节):data->SA（1）(发送应答，SDA=1)->stop（结束）
  49          //-----------------------------------------------*/
  50          unsigned char AT24C02_Readbyte(unsigned char wordaddress) //读取数据
  51          {
  52   1          unsigned char Data;
  53   1          I2C_Start();                  //开始用数据传输
  54   1          I2C_Sendbyte(AT24C02_ADDRESS);    //用数据发送（写）地址，存以后写的字节数据
C51 COMPILER V9.54   AT24C02                                                               10/31/2024 21:36:11 PAGE 2   

  55   1          I2C_Receiveack();           //接收应答//按自己写的它是1的，但它测试变0了，说明电脑给了应答
  56   1          I2C_Sendbyte(wordaddress);
  57   1          I2C_Receiveack();
  58   1          I2C_Start();
  59   1          I2C_Sendbyte(AT24C02_ADDRESS|0x01);     //写地址最低位置1变成读地址
  60   1          I2C_Receiveack();
  61   1          Data = I2C_Receivebyte();     //读取字节
  62   1          I2C_Sendack(1);
  63   1          I2C_Stop();
  64   1          
  65   1          return Data;
  66   1      }
