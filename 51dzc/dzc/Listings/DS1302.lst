 107   1          Temp = DS1302_ReadByte(DS1302_MINUTE);
 108   1        DS1302_Time[4] = Temp/16*10+Temp%16;
 109   1          Temp = DS1302_ReadByte(DS1302_SECOND);
 110   1        DS1302_Time[5] = Temp/16*10+Temp%16;
 111   1          Temp = DS1302_ReadByte(DS1302_DAY);
