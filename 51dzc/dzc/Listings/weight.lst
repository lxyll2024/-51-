 351          void Get_Weight()
 352          {
 353   1        Weight_Shiwu = HX711_Read();  //HX711读取
 354   1        Weight_Shiwu = Weight_Shiwu - Weight_Maopi;   //获取净重
 355   1        Weight_Shiwu = (unsigned int)((float)(Weight_Shiwu)/GapValue)-qupi;   //计算实物的实际重量  
 356   1        Weight_Shiwu -= 18600;
 357   1          if(Weight_Shiwu<=0 ||Weight_Shiwu>5000)
 358   1          {
 359   2          //LED=1;
 360   2          Weight_Shiwu=0;
 361   2          }
 362   1          if(Weight_Shiwu>0 && Weight_Shiwu<=5000)
C51 COMPILER V9.54   WEIGHT                                                                10/31/2024 21:36:11 PAGE 7   

 363   1          {
 364   2            //LED=1;  
 365   2            if(Weight_Shiwu > Range && mode==2)   //超重报警
 366   2            {
 367   3              Buzzer_Time(100);
 368   3              //LED=!LED;           //LED灯取反
 369   3              LED=0;
 370   3            }
 371   2              else if(mode==2 && Weight_Shiwu <= Range)
 372   2              {
 373   3                LED=1;
 374   3              } 
 375   2          }
 376   1      }


