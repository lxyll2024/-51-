  38   1          i = 1;while (--i);              //Delay 5us微秒
  39   1          Bit = OneWire_DQ;              //采样
  40   1          i = 22; while (--i);    //Delay 50us微秒
  41   1            return Bit;
  42   1        
  43   1        return Bit;
  44   1      }
  45          
  46          void OneWire_SendByte(unsigned char Byte)        //发送字节
  47          {
  48   1        unsigned char i;
  49   1        for(i=0;i<8;i++)
  50   1        {
  51   2          OneWire_SendBit(Byte & (0x01<<i));  //依次取出来得到完整字节发送
  52   2        }
  53   1      
  54   1      }
