   5          unsigned char OneWire_Init(void) //时序初始化
   6          {
   7   1        unsigned char i;
   8   1        unsigned char AckBit;     //应答位
   9   1        
  10   1        OneWire_DQ = 1;           //总线先拉高在拉低让他进入时序
