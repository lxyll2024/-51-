   1          #include <REGX52.H>
   2          #include "onewire.h"
   3          
   4          #define DS18B20_SKIP_ROM  0xcc      //转化温度暂存区指令
   5          #define DS18B20_CONVERT_T  0x44
   6          #define DS18B20_READ_SCRATCHPAD  0xBE
   7          
   8          
   9          void DS18B20_ConvertT(void)  //转换温度
  10          {
  11   1        OneWire_Init(); 
  12   1        OneWire_SendByte(DS18B20_SKIP_ROM);
  13   1        OneWire_SendByte(DS18B20_CONVERT_T);
  14   1      }
  15          
  16          float DS18B20_ReadT(void)  //读取温度
  17          {
  18   1        unsigned char TLSB,TMSB;
  19   1        int Temp;
  20   1        float T;
  21   1          OneWire_Init(); 
  22   1          OneWire_SendByte(DS18B20_SKIP_ROM);
  23   1          OneWire_SendByte(DS18B20_READ_SCRATCHPAD);  //读取温度
  24   1          
  25   1          TLSB=OneWire_ReceveByte();    //接收该温度 低位
  26   1          TMSB=OneWire_ReceveByte();    //拿出温度字节的数据 高位
  27   1          Temp=(TMSB<<8)|TLSB;    //完整的温度值
  28   1          T = Temp/16.0;   //实际温度,具体看图,防止损失精度
  29   1          return T;
  30   1        
  31   1      }
